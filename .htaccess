<IfModule mod_rewrite.c>

    # === ENABLE REWRITE ENGINE ===
    RewriteEngine On

    # === PROJECT ROOT HANDLING ===
        # DEVELOPMENT
        RewriteBase /development/ecommerce/
        RewriteRule ^home/?$ /development/ecommerce/ [R=301,L]

        # LIVE
        # RewriteBase /
        # RewriteRule ^home/?$ / [R=301,L]

    # === HTTPS REDIRECT (STAGING & PRODUCTION ONLY) ===
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|192\.168) [NC]
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # === REMOVE TRAILING SLASH FROM NON-FOLDERS & SEND TO INDEX ===
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

<IfModule mod_deflate.c>

    # Compress HTML, CSS, JavaScript, Text, XML and fonts
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml image/x-icon
    AddOutputFilterByType DEFLATE font/ttf font/otf application/font-woff2

    # Remove browser bugs (only needed for really old browsers)
    BrowserMatch ^Mozilla/4 gzip-only-text/html
    BrowserMatch ^Mozilla/4\.0[678] no-gzip
    BrowserMatch \bMSIE !no-gzip !gzip-only-text/html
    Header append Vary User-Agent

</IfModule>